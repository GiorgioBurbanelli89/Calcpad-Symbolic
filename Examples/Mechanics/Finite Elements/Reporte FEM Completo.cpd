#margen 20
#md on
"Reporte FEM completo — combinación de las 9 directivas web

# §1. Ubicación del proyecto

'Edificio aporticado de hormigón armado de 5 pisos en Quito, Ecuador.

#map 700 350
const map = L.map(MAPID).setView([-0.180653, -78.467838], 13);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap', maxZoom: 18
}).addTo(map);
L.marker([-0.180653, -78.467838]).addTo(map)
  .bindPopup('<b>Edificio aporticado 5 pisos</b><br>NEC zona V (PGA = 0.40g)')
  .openPopup();
L.circle([-0.180653, -78.467838], {
    color:'#c33', fillColor:'#f63', fillOpacity:0.15, radius:1500
}).addTo(map);
#end map

# §2. Parámetros del modelo

n_pisos = 5
n_vanos = 4
L_vano = 5
H_piso = 3
H_total = n_pisos*H_piso

#blk
n_pisos    ; 'pisos
n_vanos    ; 'vanos en cada dirección
L_vano     ; 'luz típica (m)
H_piso     ; 'altura de entrepiso (m)
H_total    ; 'altura total (m)
#end blk

# §3. Ecuación gobernante (KaTeX)

#math
\boxed{m\,\ddot{u}(t) + c\,\dot{u}(t) + k\,u(t) = F(t)}
T_n = 2\pi\sqrt{\frac{m}{k}}\quad\text{(período natural)}
\xi = \frac{c}{2\sqrt{km}}\quad\text{(razón de amortiguamiento)}
#end math

# §4. Diagrama de flujo del análisis (Mermaid)

#mermaid
flowchart LR
    A[Geometría] --> K[Matriz K]
    M[Material E,ν,ρ] --> K
    Q[Cargas q,P] --> F[Vector F]
    A --> F
    K --> S[Solver K·u=F]
    F --> S
    S --> U[Desplaz. u]
    U --> SIG[σ = D·B·u]
    SIG --> R[Reporte]
    style K fill:#b3d9ff
    style F fill:#c8e6c9
    style S fill:#ffd966
    style R fill:#ffcdd2
#end mermaid

# §5. Sparsity de la matriz K (Cytoscape)

'Cada nodo es un grado de libertad. Las aristas marcan acoplamientos
'no-cero en K. En un edificio típico la matriz tiene estructura banda
'gracias a la conectividad nodo-elemento.

#cyto 700 400
{
  elements: [
    {data:{id:'p1', label:'Piso 1'}}, {data:{id:'p2', label:'Piso 2'}},
    {data:{id:'p3', label:'Piso 3'}}, {data:{id:'p4', label:'Piso 4'}},
    {data:{id:'p5', label:'Piso 5'}}, {data:{id:'b', label:'Base'}},
    {data:{source:'b',  target:'p1'}},
    {data:{source:'p1', target:'p2'}},
    {data:{source:'p2', target:'p3'}},
    {data:{source:'p3', target:'p4'}},
    {data:{source:'p4', target:'p5'}}
  ],
  style: [
    {selector:'node', style:{
      label:'data(label)',
      'background-color':'#1f77b4',
      'color':'white', 'font-size':12,
      'text-valign':'center', 'text-halign':'center',
      'width':70, 'height':40, 'shape':'round-rectangle'
    }},
    {selector:'edge', style:{
      'width':3, 'line-color':'#888',
      'curve-style':'bezier',
      'target-arrow-shape':'triangle',
      'target-arrow-color':'#888'
    }}
  ],
  layout: {name:'breadthfirst', directed:true, padding:20}
}
#end cyto

# §6. Modelo 3D del edificio (Three.js)

#three 700 500
// Construir un edificio 5 pisos × 4 vanos × 4 vanos
const Lv = 5, Hp = 3;
const N = 4;
const Np = 5;

const colMat = new THREE.MeshStandardMaterial({color:0x666666});
const beamMat = new THREE.MeshStandardMaterial({color:0x888888});
const slabMat = new THREE.MeshStandardMaterial({color:0xffd966, transparent:true, opacity:0.4});

// Columnas
for (let ix = 0; ix <= N; ix++) {
    for (let iy = 0; iy <= N; iy++) {
        const col = new THREE.Mesh(
            new THREE.BoxGeometry(0.4, Np*Hp, 0.4),
            colMat
        );
        col.position.set(ix*Lv - N*Lv/2, Np*Hp/2, iy*Lv - N*Lv/2);
        scene.add(col);
    }
}

// Vigas X
for (let iz = 1; iz <= Np; iz++) {
    for (let iy = 0; iy <= N; iy++) {
        const beam = new THREE.Mesh(
            new THREE.BoxGeometry(N*Lv, 0.4, 0.3),
            beamMat
        );
        beam.position.set(0, iz*Hp - 0.2, iy*Lv - N*Lv/2);
        scene.add(beam);
    }
}

// Vigas Y
for (let iz = 1; iz <= Np; iz++) {
    for (let ix = 0; ix <= N; ix++) {
        const beam = new THREE.Mesh(
            new THREE.BoxGeometry(0.3, 0.4, N*Lv),
            beamMat
        );
        beam.position.set(ix*Lv - N*Lv/2, iz*Hp - 0.2, 0);
        scene.add(beam);
    }
}

// Losas
for (let iz = 1; iz <= Np; iz++) {
    const slab = new THREE.Mesh(
        new THREE.BoxGeometry(N*Lv, 0.1, N*Lv),
        slabMat
    );
    slab.position.set(0, iz*Hp - 0.05, 0);
    scene.add(slab);
}

scene.add(new THREE.AmbientLight(0xffffff, 0.5));
const dir = new THREE.DirectionalLight(0xffffff, 0.8);
dir.position.set(15, 25, 20);
scene.add(dir);

camera.position.set(25, 18, 25);
camera.lookAt(0, Np*Hp/2, 0);
#end three

