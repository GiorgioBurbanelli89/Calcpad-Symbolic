# §8. Geometría dinámica — explorá el Q4 (JSXGraph)

'Mové las esquinas del cuadrilátero con el mouse y mirá cómo cambia
'el área. Para Q4 degenerado (esquinas casi colineales) el det(J) ≈ 0
'y el solver tira el warning "negative Jacobian".

#jsx 500 500
const board = JXG.JSXGraph.initBoard(JSXBOARD, {
    boundingbox:[-1, 6, 6, -1], axis:true,
    showCopyright:false, showNavigation:false
});
const A = board.create('point', [0, 0],   {name:'1', size:6, color:'#c33'});
const B = board.create('point', [4, 0.5], {name:'2', size:6, color:'#c33'});
const C = board.create('point', [4.5, 4], {name:'3', size:6, color:'#c33'});
const D = board.create('point', [0.5, 3.5], {name:'4', size:6, color:'#c33'});
board.create('polygon', [A,B,C,D], {
    fillColor:'#ffd966', fillOpacity:0.4,
    borderColor:'#b58900', borderWidth:2
});
board.create('text', [0.3, 5.5,
    () => 'Área = ' + Math.abs(0.5*((A.X()-C.X())*(B.Y()-D.Y()) - (B.X()-D.X())*(A.Y()-C.Y()))).toFixed(3)
], {fontSize:18, color:'#0d47a1'});
#end jsx

# §9. Diagrama de combinaciones de carga (Graphviz DOT)

#dot 700 350
digraph G {
    rankdir=LR;
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11];

    D [label="DEAD\\n(peso propio)", fillcolor=lightgreen];
    L [label="LIVE\\n(uso)", fillcolor=lightblue];
    E [label="EARTHQUAKE\\n(sismo)", fillcolor=gold];

    C1 [label="1.4·D", fillcolor=white];
    C2 [label="1.2·D + 1.6·L", fillcolor=white];
    C3 [label="1.2·D + 1.0·L + 1.0·E", fillcolor=lightcoral];

    Gov [label="GOBERNANTE", fillcolor="#ffcccc", shape=octagon];

    D -> C1; D -> C2; D -> C3;
    L -> C2; L -> C3;
    E -> C3;
    C1 -> Gov; C2 -> Gov; C3 -> Gov;
}
#end dot

# §10. Espectro de respuesta sísmico (Canvas)

'Espectro de pseudo-aceleración Sa(T) según NEC-SE-DS para zona V,
'suelo D, importancia I=1.0.

#canvas 700 350
ctx.fillStyle = '#fafafa'; ctx.fillRect(0, 0, width, height);

// Título
ctx.fillStyle = '#222'; ctx.font = 'bold 16px sans-serif';
ctx.textAlign = 'center';
ctx.fillText('Espectro Sa(T) — NEC-SE-DS Quito (zona V, suelo D)', width/2, 25);

// Ejes
ctx.strokeStyle = '#333'; ctx.lineWidth = 1.5;
ctx.beginPath();
ctx.moveTo(60, 50); ctx.lineTo(60, 300); ctx.lineTo(680, 300);
ctx.stroke();

// Etiquetas ejes
ctx.fillStyle = '#444'; ctx.font = '12px sans-serif';
ctx.textAlign = 'right';
ctx.fillText('Sa (g)', 55, 60);
ctx.textAlign = 'center';
ctx.fillText('T (s)', 670, 320);

// Curva del espectro NEC: To = 0.1, Tc = 0.5, η = 2.48 (zona V suelo D)
const To = 0.1, Tc = 0.5, eta = 2.48, Z = 0.40, Fa = 1.20;
const Sa_max = Z * Fa * eta;
function Sa(T) {
    if (T <= To) return Z*Fa*(1 + (eta-1)*T/To);
    if (T <= Tc) return Sa_max;
    return Sa_max * Tc/T;
}
const Tmax = 4.0;
ctx.beginPath();
ctx.strokeStyle = '#c33';
ctx.lineWidth = 2.5;
for (let i = 0; i <= 200; i++) {
    const T = i*Tmax/200;
    const px = 60 + T/Tmax * 620;
    const py = 300 - Sa(T)/Sa_max * 230;
    if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
}
ctx.stroke();

// Marcas
ctx.fillStyle = '#0d47a1'; ctx.font = 'bold 12px sans-serif';
ctx.textAlign = 'left';
ctx.fillText('To = 0.1s', 75, 70);
ctx.fillText('Tc = 0.5s', 60 + 0.5/Tmax*620 + 5, 90);
ctx.fillText('Sa,max = ' + Sa_max.toFixed(2) + 'g', 250, 70);

// Marcas de período T1 del edificio
ctx.fillStyle = '#2e7d32';
ctx.beginPath();
ctx.arc(60 + 0.6718/Tmax*620, 300 - Sa(0.6718)/Sa_max*230, 5, 0, 2*Math.PI);
ctx.fill();
ctx.fillText('T1 edificio = 0.67s', 60 + 0.6718/Tmax*620 + 8, 300 - Sa(0.6718)/Sa_max*230 - 8);
#end canvas

# Cierre

'**Reporte combinando 8 directivas web del parser:**
'  §1 #map     ← ubicación geográfica
'  §3 #math    ← ecuaciones LaTeX
'  §4 #mermaid ← flujo de cálculo
'  §5 #cyto    ← sparsity de K
'  §6 #three   ← modelo 3D rotable
'  §7 #plotly  ← gráfica de períodos
'  §8 #jsx     ← Q4 dinámico
'  §9 #dot     ← combos de carga
'  §10 #canvas ← espectro NEC
'
'Ningún `<>` HTML escrito a mano. Todo el wrapping (div, script, CDN,
'init) lo genera el parser automáticamente.
