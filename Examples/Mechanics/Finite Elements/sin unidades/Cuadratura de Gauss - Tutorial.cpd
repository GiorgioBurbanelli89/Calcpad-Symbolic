'Calculo SIMBOLICO de la integral real con #sym:
#sym integrate(1; x; -1; 1)

'Aproximacion numerica con la regla de 1 punto y comparacion:
I_real_const = 2
I_1pt_const = 2*1
err_const = abs(I_real_const - I_1pt_const)
#blk
I_real_const ; 'area exacta debajo de f(x) = 1
I_1pt_const  ; 'aproximacion 1-punto: 2*f(0) = 2*1
err_const    ; 'error = 0  ->  EXACTO
#end blk

