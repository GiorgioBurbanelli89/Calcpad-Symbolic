"FE01 - Membrana Q4 cantilever wall (port MATLAB con contorno real)
'Esta version NO se queda en computar el K del elemento — arma una
'malla completa, ensambla, aplica BCs, resuelve K*u = F y dibuja
'el CONTORNO de desplazamientos horizontales como un FEM real.
'
'Equivalencia MATLAB:
'   nds, els (matrices de coords y conectividad)
'   Ke (rigidez del elemento, igual al script MATLAB original)
'   ensamble por superposicion
'   penalizacion para BCs (suelo)
'   clsolve para resolver el sistema
'   spline + $Map para contorno

"1. Datos del muro
'Cantilever vertical: empotrado abajo, carga lateral arriba.
W_m = 5'm
H_m = 3'm
t_w = 0.2'm
P = 100'kN
E = 25000'MPa
ν = 0.2
#blk
W_m ; 'ancho del muro
H_m ; 'altura del muro
t_w ; 'espesor
P   ; 'carga lateral total (en la cima, repartida)
E   ; 'modulo de elasticidad
ν   ; 'Poisson
#end blk

"2. Malla de elementos finitos
'n_x x n_y elementos Q4, 2 DOFs por nodo (u, v).
n_dof = 2
n_x = 4
n_y = 3
n_e = n_x*n_y
n_j = (n_x + 1)*(n_y + 1)
d_x = W_m/n_x
d_y = H_m/n_y
n_total = n_dof*n_j
#blk
n_x     ; 'elementos en x
n_y     ; 'elementos en y
n_e     ; 'total elementos
n_j     ; 'total nodos
n_total ; 'total DOFs
#end blk

#hide
n_1 = n_x + 1
'Generar coords nodales
x_j = vector(n_j)
y_j = vector(n_j)
#for j = 0 : n_y
	#for i = 0 : n_x
		k = j*n_1 + i + 1
		x_j.k = i*d_x
		y_j.k = j*d_y
	#loop
#loop
'Conectividad de los elementos (nodos por elemento, sentido CCW)
e_j = matrix(n_e; 4)
#for j = 0 : n_y - 1
	#for i = 0 : n_x - 1
		e = j*n_x + i + 1
		bl = j*n_1 + i + 1
		e_j.(e; 1) = bl
		e_j.(e; 2) = bl + 1
		e_j.(e; 3) = bl + n_1 + 1
		e_j.(e; 4) = bl + n_1
	#loop
#loop
'Nodos en la base (empotrados): s_j = primera fila de nodos
n_s = n_1
s_j = vector(n_s)
#for i = 1 : n_s
	s_j.i = i
#loop
n_top = n_1
#show

"3. Matriz constitutiva D y rigidez del elemento Ke
'Plane stress (no se imprime con #hide)
c_D = E*t_w/(1 - ν^2)
D_mat = c_D*[1; ν; 0 | ν; 1; 0 | 0; 0; (1 - ν)/2]

'Derivadas de las funciones de forma Q4 bilineales
dN_1ξ(η) = -(1 - η)/4
dN_2ξ(η) =  (1 - η)/4
dN_3ξ(η) =  (1 + η)/4
dN_4ξ(η) = -(1 + η)/4
dN_1η(ξ) = -(1 - ξ)/4
dN_2η(ξ) = -(1 + ξ)/4
dN_3η(ξ) =  (1 + ξ)/4
dN_4η(ξ) =  (1 - ξ)/4

'Jacobiano de un elemento rectangular (uniforme)
J_11 = d_x/2
J_22 = d_y/2
det_J = J_11*J_22

'Ensamble del Ke con integracion Gauss 2x2
g = 1/sqr(3)
#hide
n_k = n_dof*4
K_e = symmetric(n_k)
#for ig = 1 : 4
	#if ig ≡ 1
		ξ_g = -g','η_g = -g
	#else if ig ≡ 2
		ξ_g =  g','η_g = -g
	#else if ig ≡ 3
		ξ_g =  g','η_g =  g
	#else
		ξ_g = -g','η_g =  g
	#end if
	dNdx_1 = dN_1ξ(η_g)/J_11','dNdy_1 = dN_1η(ξ_g)/J_22
	dNdx_2 = dN_2ξ(η_g)/J_11','dNdy_2 = dN_2η(ξ_g)/J_22
	dNdx_3 = dN_3ξ(η_g)/J_11','dNdy_3 = dN_3η(ξ_g)/J_22
	dNdx_4 = dN_4ξ(η_g)/J_11','dNdy_4 = dN_4η(ξ_g)/J_22
	B = [dNdx_1; 0; dNdx_2; 0; dNdx_3; 0; dNdx_4; 0 | _
	     0; dNdy_1; 0; dNdy_2; 0; dNdy_3; 0; dNdy_4 | _
	     dNdy_1; dNdx_1; dNdy_2; dNdx_2; dNdy_3; dNdx_3; dNdy_4; dNdx_4]
	BtDB = transp(B)*D_mat*B*det_J
	#for i = 1 : n_k
		#for j = i : n_k
			K_e.(i; j) = K_e.(i; j) + BtDB.(i; j)
		#loop
	#loop
#loop
#show
'Matriz Ke (8x8) - igual al script MATLAB:
K_e

"4. Ensamblaje global y resolucion
#hide
K = symmetric(n_total)
#for e = 1 : n_e
	#for i = 1 : 4
		#for j = i : 4
			j_1 = e_j.(e; i)
			j_2 = e_j.(e; j)
			i_1 = n_dof*(j_1 - 1) + 1
			i_2 = n_dof*(j_2 - 1) + 1
			k_ij = submatrix(K_e; n_dof*(i - 1) + 1; n_dof*i; n_dof*(j - 1) + 1; n_dof*j)
			#if j_1 > j_2
				add(transp(k_ij); K; i_2; i_1)
			#else
				add(k_ij; K; i_1; i_2)
			#end if
		#loop
	#loop
#loop
'BCs: penalizacion en nodos de la base (u = v = 0)
k_p = 10^20
#for i = 1 : n_s
	j = n_dof*(s_j.i - 1) + 1
	K.(j; j) = K.(j; j) + k_p
	K.(j + 1; j + 1) = K.(j + 1; j + 1) + k_p
#loop
'Vector de cargas: P horizontal repartido en nodos del top
F = vector(n_total)
p_n = P/n_top
#for i = 1 : n_top
	j_top = n_y*n_1 + i
	F.(n_dof*(j_top - 1) + 1) = p_n
#loop
#show
'Resolviendo K*u = F ...
Z = clsolve(K; F)

"5. Resultados
#hide
u_disp = vector(n_j)
v_disp = vector(n_j)
#for i = 1 : n_j
	u_disp.i = Z.(n_dof*i - 1)
	v_disp.i = Z.(n_dof*i)
#loop
u_max = 0','u_node = 0
#for i = 1 : n_top
	j_top = n_y*n_1 + i
	u_i = u_disp.j_top
	#if abs(u_i) > abs(u_max)
		u_max = u_i
		u_node = j_top
	#end if
#loop
#show
'Desplazamiento horizontal maximo en la parte superior:
u_max
'(en el nodo 'u_node')

"5.1 Mapa de desplazamientos horizontales (CONTORNO con $Map)
'Construye una grilla de valores u(x, y) y un spline 2D para interpolar.
#hide
U_grid = matrix(n_x + 1; n_y + 1)
#for i_x = 0 : n_x
	#for i_y = 0 : n_y
		k = i_y*n_1 + i_x + 1
		U_grid.(i_x + 1; i_y + 1) = u_disp.k
	#loop
#loop
u_map(x; y) = spline(1 + x/d_x; 1 + y/d_y; U_grid)
PlotWidth = 50*W_m
PlotHeight = 50*H_m
PlotStep = 10
#show
'Desplazamiento horizontal u (sistema m):
$Map{u_map(x; y) @ x = 0 : W_m & y = 0 : H_m}

"5.2 Mapa de desplazamientos verticales
#hide
V_grid = matrix(n_x + 1; n_y + 1)
#for i_x = 0 : n_x
	#for i_y = 0 : n_y
		k = i_y*n_1 + i_x + 1
		V_grid.(i_x + 1; i_y + 1) = v_disp.k
	#loop
#loop
v_map(x; y) = spline(1 + x/d_x; 1 + y/d_y; V_grid)
#show
'Desplazamiento vertical v (sistema m):
$Map{v_map(x; y) @ x = 0 : W_m & y = 0 : H_m}

"6. Validacion (vs teoria de vigas)
I_w = t_w*W_m^3/12
'Momento de inercia: I_w
δ_beam = P*H_m^3/(3*E*I_w)
'Deflexion teorica viga Euler-Bernoulli: δ_beam
'(es solo referencia; FEM membrana incluye corte, viga no)
ratio = abs(u_max)/δ_beam
'Ratio FEM/Viga: ratio
'(>1 esperado: FEM membrana captura corte transversal que viga ignora)
