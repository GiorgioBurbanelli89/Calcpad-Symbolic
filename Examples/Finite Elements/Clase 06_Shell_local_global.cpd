"Coordenadas globales del elemento :
X_g = [0; 5; 5; 1]
Y_g = [0; 0; 4; 4]
Z_g = [1; 1; 2; 2]

"Longitud de 1-3:
l_13 = ?^(1/(X_g.1 - X_g.3)^2 + (Y_g.1 - Y_g.3)^2 + (Z_g.1 - Z_g.3)^2)

"Vector unitario:
v_1 = 1/l_13*[X_g.3 - X_g.1; Y_g.3 - Y_g.1; Z_g.3 - Z_g.1]

"Longitud de 2-4:
l_24 = ?^(1/(X_g.2 - X_g.4)^2 + (Y_g.2 - Y_g.4)^2 + (Z_g.2 - Z_g.4)^2)

"Vector unitario:
v_2 = 1/l_24*[X_g.4 - X_g.2; Y_g.4 - Y_g.2; Z_g.4 - Z_g.2]
n = 'crossProduct(v_1; v_2)/det('crossProduct(v_1; v_2))
t_1 = v_1 - v_2/det(v_1 - v_2)
t_2 = v_1 + v_2/det(v_1 + v_2)
T = [t_1.1; t_1.2; t_1.3|t_2.1; t_2.2; t_2.3|n.1; n.2; n.3]
XYZ = stack(transp(X_g); transp(Y_g); transp(Z_g))
X_l = T*XYZ

"Coordenadas locales del elemento:
XY = transp(submatrix(X_l; 1; 2; 1; 4))

"Modulo de Elasticidad:
E = 5000

"Coeficiente de Poisson:
ν = 0.20

"Modulo de Elasticidad a corte:
G = E/(2*(1 + ν))

"Espesor de la placa:
d = 6

"Coeficiente de corrección por corte:
κ = 5/6

"Matriz constitutiva de membrana:
D_m = E*d/(1 - ν^2)*[1; ν; 0|ν; 1; 0|0; 0; 1 - ν/2]

"Matriz constitutiva a flexión:
D_f = E*d^3/(12*(1 - ν^2))*[1; ν; 0|ν; 1; 0|0; 0; 1 - ν/2]

"Matriz constitutiva a corte:
D_s = κ*G*d*[1; 0|0; 1]

"Funciones de interpolación:
N_1(ξ; η) = 1/4*(1 - ξ)*(1 - η)
N_3(ξ; η) = 1/4*(1 + ξ)*(1 + η)
N_2(ξ; η) = 1/4*(1 + ξ)*(1 - η)
N_4(ξ; η) = 1/4*(1 - ξ)*(1 + η)
N(ξ; η) = [N_1(ξ; η); N_2(ξ; η); N_3(ξ; η); N_4(ξ; η)]

"Derivadas de las funciones de interpolación:
#sym dN(ξ; η) = [pdiff(N_1(ξ; η); ξ); pdiff(N_2(ξ; η); ξ); pdiff(N_3(ξ; η); ξ); pdiff(N_4(ξ; η); ξ)|pdiff(N_1(ξ; η); η); pdiff(N_2(ξ; η); η); pdiff(N_3(ξ; η); η); pdiff(N_4(ξ; η); η)]

"Jacobiano:
J(ξ; η) = dN(ξ; η)*XY

"Derivadas de las funciones de interpolación con respecto al sistema original:
d'N(ξ; η) = (J(ξ; η)^(-1))*dN(ξ; η)

"Construcción de la matriz de deformación para membrana:
f(i; j) = 0
''B_m:
t = matrix(3; 24; f)
#for i = 1 : 4
    t.1; 6*i - 5 = (d'N(ξ; η)).1; i
    t.2; 6*i - 4 = (d'N(ξ; η)).2; i
    t.3; 6*i - 5 = (d'N(ξ; η)).2; i
    t.3; 6*i - 4 = (d'N(ξ; η)).1; i
#loop

"Construcción de la matriz de deformación para flexión:
''B_b:
t = matrix(3; 24; f)
#for i = 1 : 4
    t.1; 6*i - 1 = -(d'N(ξ; η)).1; i
    t.2; 6*i - 2 = (d'N(ξ; η)).2; i
    t.3; 6*i - 1 = -(d'N(ξ; η)).2; i
    t.3; 6*i - 2 = (d'N(ξ; η)).1; i
#loop

"Construcción de la matriz de deformación por corte:
''B_s:
t = matrix(2; 24; f)
#for i = 1 : 4
    t.1; 6*i - 3 = (d'N(ξ; η)).1; i
    t.1; 6*i - 1 = (N(ξ; η)).1; i
    t.2; 6*i - 3 = (d'N(ξ; η)).2; i
    t.2; 6*i - 2 = -(N(ξ; η)).1; i
#loop

"Puntos de integración:
ξ' = [-1/?^(1/3); -(1/?^(1/3)); 1/?^(1/3); 1/?^(1/3)]
η' = [-1/?^(1/3); 1/?^(1/3); -(1/?^(1/3)); 1/?^(1/3)]
W = [1; 1; 1; 1]

"Matrices aumentadas para integración reducida:
D_m = stack(augment(D_m; matrix(3; 5; f)); matrix(5; 8; f))
D_f = stack(matrix(3; 8; f); augment(matrix(3; 3; f); D_f; matrix(3; 2; f)); matrix(2; 8; f))
D_s = stack(matrix(6; 8; f); augment(matrix(2; 6; f); D_s))
B_m(ξ; η) = stack(B_m(ξ; η); matrix(5; 24; f))
B_b(ξ; η) = stack(matrix(3; 24; f); B_b(ξ; η); matrix(2; 24; f))
B_b(0; 0)
B_s(ξ; η) = stack(matrix(6; 24; f); B_s(ξ; η))

"Matriz de rigidez:
j = 1 : 4
Φ'.j = transp((B_m(ξ'.j; η'.j)))*D_m*(B_m(ξ'.j; η'.j))*det(J(ξ'.j; η'.j))*W.j
K_m = sum(Φ'.j; 1; 4)
Φ.j = transp((B_b(ξ'.j; η'.j)))*D_f*(B_b(ξ'.j; η'.j))*det(J(ξ'.j; η'.j))*W.j
K_b = sum(Φ.j; 1; 4)
K_s = 2*2*transp((B_s(0; 0)))*D_s*(B_s(0; 0))*det(J(0; 0))
Φ''.j = transp((B_s(ξ'.j; η'.j)))*D_s*(B_s(ξ'.j; η'.j))*det(J(ξ'.j; η'.j))*W.j
K_s = sum(Φ''.j; 1; 4)
K_T = K_m + K_b + K_s
K_m
K_b
K_s
K_T
T' = matrix(3; 3; f)
T = stack(augment(T; T'); augment(T'; T))
T' = matrix(6; 6; f)
R = stack(augment(T; T'; T'; T'); augment(T'; T; T'; T'); augment(T'; T'; T; T'); augment(T'; T'; T'; T))
R
K_G = transp(R)*K_T*R
