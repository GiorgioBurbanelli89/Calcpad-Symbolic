#margen 20
"Matrices de Rigidez de Vigas — Operaciones Simbolicas

"1. RIGIDEZ AXIAL

"Funciones de forma y suma
#sym
simplify((1 - ξ)/2 + (1 + ξ)/2)
#end sym

"Derivadas de las funciones de forma
#sym
diff((1 - ξ)/2; ξ)
#end sym
#sym
diff((1 + ξ)/2; ξ)
#end sym

"Terminos de la matriz de rigidez axial

#sym
integrate((-1/L)*E*(-1/L)*A*(L/2); ξ)
#end sym
#sym
integrate((-1/L)*E*(1/L)*A*(L/2); ξ)
#end sym
#sym
integrate((1/L)*E*(-1/L)*A*(L/2); ξ)
#end sym
#sym
integrate((1/L)*E*(1/L)*A*(L/2); ξ)
#end sym

"Evaluamos de -1 a 1
#sym
simplify(A*E/(2*L)*1 - A*E/(2*L)*(-1))
#end sym
#sym
simplify(-A*E/(2*L)*1 - (-A*E/(2*L)*(-1)))
#end sym

"Matriz de rigidez axial
#noc
K = (E*A/L)*[1; -1|-1; 1]
#equ

#pgb
"2. RIGIDEZ A FLEXION

"Funciones de forma de Hermite (ξ de 0 a 1)
#sym
simplify(1 - 3*ξ^2 + 2*ξ^3)
#end sym
#sym
simplify(ξ - 2*ξ^2 + ξ^3)
#end sym
#sym
simplify(3*ξ^2 - 2*ξ^3)
#end sym
#sym
simplify(-ξ^2 + ξ^3)
#end sym

"Primeras derivadas
#sym
diff(1 - 3*ξ^2 + 2*ξ^3; ξ)
#end sym
#sym
diff(ξ - 2*ξ^2 + ξ^3; ξ)
#end sym
#sym
diff(3*ξ^2 - 2*ξ^3; ξ)
#end sym
#sym
diff(-ξ^2 + ξ^3; ξ)
#end sym

"Segundas derivadas
#sym
diff(1 - 3*ξ^2 + 2*ξ^3; ξ; 2)
#end sym
#sym
diff(ξ - 2*ξ^2 + ξ^3; ξ; 2)
#end sym
#sym
diff(3*ξ^2 - 2*ξ^3; ξ; 2)
#end sym
#sym
diff(-ξ^2 + ξ^3; ξ; 2)
#end sym

"Integrales de B_i * B_j (primera fila, ξ de 0 a 1)
#sym
integrate((-6 + 12*ξ)*(-6 + 12*ξ); ξ)
#end sym
#sym
integrate((-6 + 12*ξ)*(-4 + 6*ξ); ξ)
#end sym
#sym
integrate((-6 + 12*ξ)*(6 - 12*ξ); ξ)
#end sym
#sym
integrate((-6 + 12*ξ)*(-2 + 6*ξ); ξ)
#end sym

"Evaluamos cada integral de 0 a 1
'K(1,1):
#sym
simplify((36*1 - 36*1^2 + 48*1^3) - (36*0 - 36*0^2 + 48*0^3))
#end sym
'K(1,2):
#sym
simplify((24*1 - 42*1^2 + 24*1^3) - (24*0 - 42*0^2 + 24*0^3))
#end sym
'K(1,3):
#sym
simplify((-36*1 + 36*1^2 - 48*1^3) - (-36*0 + 36*0^2 - 48*0^3))
#end sym
'K(1,4):
#sym
simplify((12*1 - 30*1^2 + 24*1^3) - (12*0 - 30*0^2 + 24*0^3))
#end sym

'Los coeficientes son 48, 6, -48, 6.
'Multiplicados por E*I/L^3 y con los factores L de las rotaciones
'dan la matriz conocida:

"Matriz de rigidez a flexion
#noc
K = (E*I/L^3)*[12; 6*L; -12; 6*L|6*L; 4*L^2; -6*L; 2*L^2|-12; -6*L; 12; -6*L|6*L; 2*L^2; -6*L; 4*L^2]
#equ

#pgb
"3. RIGIDEZ A TORSION

"Derivadas de las funciones de forma
#sym
diff((1 - ξ)/2; ξ)
#end sym
#sym
diff((1 + ξ)/2; ξ)
#end sym

"Terminos de la matriz de rigidez torsional
#sym
integrate((-1/L)*G*J*(-1/L)*(L/2); ξ)
#end sym
#sym
integrate((-1/L)*G*J*(1/L)*(L/2); ξ)
#end sym
#sym
integrate((1/L)*G*J*(-1/L)*(L/2); ξ)
#end sym
#sym
integrate((1/L)*G*J*(1/L)*(L/2); ξ)
#end sym

"Matriz de rigidez torsional
#noc
K = (G*J/L)*[1; -1|-1; 1]
#equ

#pgb
"4. RIGIDEZ A CORTANTE

"Derivadas de las funciones de forma
#sym
diff((1 - ξ)/2; ξ)
#end sym
#sym
diff((1 + ξ)/2; ξ)
#end sym

"Terminos de la matriz de rigidez cortante
#sym
integrate((-1/L)*κ*G*A*(-1/L)*(L/2); ξ)
#end sym
#sym
integrate((-1/L)*κ*G*A*(1/L)*(L/2); ξ)
#end sym
#sym
integrate((1/L)*κ*G*A*(-1/L)*(L/2); ξ)
#end sym
#sym
integrate((1/L)*κ*G*A*(1/L)*(L/2); ξ)
#end sym

"Matriz de rigidez cortante
#noc
K = (κ*G*A/L)*[1; -1|-1; 1]
#equ

#pgb
"RESUMEN
#noc
K_axial = (E*A/L)*[1; -1|-1; 1]
#equ
#noc
K_flex = (E*I/L^3)*[12; 6*L; -12; 6*L|6*L; 4*L^2; -6*L; 2*L^2|-12; -6*L; 12; -6*L|6*L; 2*L^2; -6*L; 4*L^2]
#equ
#noc
K_tor = (G*J/L)*[1; -1|-1; 1]
#equ
#noc
K_cor = (κ*G*A/L)*[1; -1|-1; 1]
#equ
#end margen
