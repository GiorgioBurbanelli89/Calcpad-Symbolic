#margen 20
"Metodo de Newmark-β — Ejemplo Paz (Cap. 5/6 Matlab)

'SDOF sometido a excitacion sismica. Se integra la ecuacion
'   m·ü + c·u̇ + k·u = -m·a_g(t)
'con el metodo de Newmark de aceleracion lineal (β=1/6, γ=1/2).

"Datos

#blk
'Asignacion ; 'Descripcion
m = 1 ; 'Masa (unitaria normalizada)
ξ = 0.10 ; 'Razon de amortiguamiento (10%)
T_n = 1.0 ; 'Periodo natural del sistema (s)
g = 386 ; 'Gravedad (in/s²)
#end blk

'Parametros derivados:
ω_n = 2*π/T_n
k = ω_n^2*m
c = 2*m*ω_n*ξ

#blk
'Asignacion ; 'Descripcion
ω_n = 2*π/T_n ; 'Frecuencia angular natural (rad/s)
k = ω_n^2*m ; 'Rigidez (lb/in)
c = 2*m*ω_n*ξ ; 'Amortiguamiento (lb·s/in)
#end blk

#pgb
"Excitacion sismica — señal sintetica tipo El Centro

'Para el ejemplo, uso una señal sintetica con 3 armonicos.
'En aplicacion real se cargarian los datos del acelerograma.

dt = 0.01
n_pts = 500
t_fin = dt*(n_pts - 1)

#hide
t_s = vector(n_pts)
Ag = vector(n_pts)

#for i = 1 : n_pts
    t_i = (i - 1)*dt
    t_s.(i) = t_i
    'Señal sintetica tipo El Centro (amplitud maxima ~0.3g):
    Ag.(i) = 0.25*sin(2*π*2*t_i)*exp(-0.3*t_i) + 0.15*sin(2*π*5*t_i)*exp(-0.5*t_i) + 0.08*sin(2*π*8*t_i)*exp(-0.7*t_i)
#loop
#show

"Grafica de la excitacion sismica

$Chart{t_s; Ag @ title=Aceleracion del suelo a_g(t) : xlabel=tiempo (s) : ylabel=a_g (g)}

#pgb
"Coeficientes Newmark — aceleracion lineal

'Metodo de Newmark β (β=1/6, γ=1/2) — aceleracion lineal.
'Incondicionalmente estable para sistemas lineales.

γ_n = 0.5
β_n = 1/6

'Coeficientes Eq. 6.45 del libro Paz:
k_bar = k + γ_n*c/(β_n*dt) + m/(β_n*dt^2)
A_coef = m/(β_n*dt) + γ_n*c/β_n
B_coef = m/(2*β_n) + dt*c*(0.5*γ_n/β_n - 1)

#pgb
"Integracion Newmark paso a paso

'Inicializacion:
u_0 = 0
v_0 = 0
a_0 = -g*Ag.(1)/m

#hide
u_hist = vector(n_pts)
v_hist = vector(n_pts)
a_hist = vector(n_pts)

u_hist.(1) = u_0
v_hist.(1) = v_0
a_hist.(1) = a_0

'Loop temporal — Newmark-β explicito:
#for i = 1 : n_pts - 1
    'Incremento de fuerza externa (base motion):
    DF = -m*g*(Ag.(i+1) - Ag.(i))

    'Fuerza efectiva Eq. 6.46:
    DF_bar = DF + A_coef*v_hist.(i) + B_coef*a_hist.(i)

    'Incremento de desplazamiento Eq. 6.44:
    Du = DF_bar/k_bar

    'Incremento de velocidad Eq. 6.43:
    Dv = γ_n*Du/(β_n*dt) - γ_n*v_hist.(i)/β_n + dt*a_hist.(i)*(1 - 0.5*γ_n/β_n)

    'Incremento de aceleracion Eq. 6.42:
    Da = Du/(β_n*dt^2) - v_hist.(i)/(β_n*dt) - a_hist.(i)/(2*β_n)

    'Actualizar:
    u_hist.(i+1) = u_hist.(i) + Du
    v_hist.(i+1) = v_hist.(i) + Dv
    a_hist.(i+1) = a_hist.(i) + Da
#loop
#show

#pgb
"Respuesta — desplazamiento u(t)

$Chart{t_s; u_hist @ title=Respuesta de desplazamiento u(t) : xlabel=tiempo (s) : ylabel=u (in)}

"Respuesta — velocidad v(t)

$Chart{t_s; v_hist @ title=Respuesta de velocidad v(t) : xlabel=tiempo (s) : ylabel=v (in/s)}

"Respuesta — aceleracion a(t)

$Chart{t_s; a_hist @ title=Respuesta de aceleracion a(t) : xlabel=tiempo (s) : ylabel=a (in/s²)}

#pgb
"Valores maximos (espectros para este periodo T)

u_max = max(u_hist)
v_max = max(v_hist)
a_max = max(a_hist)

u_min = min(u_hist)
v_min = min(v_hist)
a_min = min(a_hist)

#blk
'Cantidad ; 'Valor maximo ; 'Valor minimo
'Desplazamiento (in) ; u_max ; u_min
'Velocidad (in/s) ; v_max ; v_min
'Aceleracion (in/s²) ; a_max ; a_min
#end blk

#pgb
"Espectros de respuesta — barrido en periodos

'Para construir espectros Sd(T), Sv(T), Sa(T) se repite el
'analisis para muchos periodos T y se registra el max.

'Aqui hago 5 periodos como muestra:

#hide
T_array = [0.1; 0.3; 0.5; 1.0; 2.0]
n_T = 5

S_d = vector(n_T)
S_v = vector(n_T)
S_a = vector(n_T)

#for j = 1 : n_T
    'Periodo actual:
    T_j = T_array.(j)
    ω_j = 2*π/T_j
    k_j = ω_j^2*m
    c_j = 2*m*ω_j*ξ

    'Coeficientes Newmark:
    kbar_j = k_j + γ_n*c_j/(β_n*dt) + m/(β_n*dt^2)
    A_j = m/(β_n*dt) + γ_n*c_j/β_n
    B_j = m/(2*β_n) + dt*c_j*(0.5*γ_n/β_n - 1)

    'Integracion:
    u_j = 0
    v_j = 0
    a_j = -g*Ag.(1)/m
    umax_j = 0

    #for i = 1 : n_pts - 1
        DF_j = -m*g*(Ag.(i+1) - Ag.(i))
        DFb_j = DF_j + A_j*v_j + B_j*a_j
        Du_j = DFb_j/kbar_j
        Dv_j = γ_n*Du_j/(β_n*dt) - γ_n*v_j/β_n + dt*a_j*(1 - 0.5*γ_n/β_n)
        Da_j = Du_j/(β_n*dt^2) - v_j/(β_n*dt) - a_j/(2*β_n)
        u_j = u_j + Du_j
        v_j = v_j + Dv_j
        a_j = a_j + Da_j
        #if abs(u_j) > umax_j
            umax_j = abs(u_j)
        #end if
    #loop

    S_d.(j) = umax_j
    S_v.(j) = umax_j*ω_j
    S_a.(j) = umax_j*ω_j^2/g
#loop
#show

"Grafica — Espectro de desplazamiento Sd(T)

$Chart{T_array; S_d @ title=Espectro de desplazamiento S_d : xlabel=Periodo T (s) : ylabel=S_d (in)}

"Grafica — Espectro de velocidad Sv(T)

$Chart{T_array; S_v @ title=Espectro de pseudo-velocidad S_v : xlabel=Periodo T (s) : ylabel=S_v (in/s)}

"Grafica — Espectro de aceleracion Sa(T)

$Chart{T_array; S_a @ title=Espectro de pseudo-aceleracion S_a : xlabel=Periodo T (s) : ylabel=S_a (g)}

#blk
'Periodo T (s) ; 'S_d (in) ; 'S_v (in/s) ; 'S_a (g)
'0.1 ; S_d.(1) ; S_v.(1) ; S_a.(1)
'0.3 ; S_d.(2) ; S_v.(2) ; S_a.(2)
'0.5 ; S_d.(3) ; S_v.(3) ; S_a.(3)
'1.0 ; S_d.(4) ; S_v.(4) ; S_a.(4)
'2.0 ; S_d.(5) ; S_v.(5) ; S_a.(5)
#end blk
#end margen
