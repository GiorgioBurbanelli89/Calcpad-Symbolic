'Fuente: Calculo de estructuras por el método de los elementos finitos (Oñate)

"Modulo de Elasticidad:
E = 2*10^7

"Coeficiente de Poisson:
ν = 0.30

"Modulo de Elasticidad a corte:
G = E/(2*(1 + ν))

"Espesor de la placa:
d = 0.02

"Coeficiente de corrección por corte:
κ = 5/6

"Matriz constitutiva a flexión:
D_f = E*d^3/(12*(1 - ν^2))*[1; ν; 0|ν; 1; 0|0; 0; 1 - ν/2]

"Matriz constitutiva a corte:
D_s = κ*G*d*[1; 0|0; 1]

"Funciones de interpolación:
N_1(ξ; η) = 1/4*(1 - ξ)*(1 - η)
N_3(ξ; η) = 1/4*(1 + ξ)*(1 + η)
N_2(ξ; η) = 1/4*(1 + ξ)*(1 - η)
N_4(ξ; η) = 1/4*(1 - ξ)*(1 + η)
N(ξ; η) = [N_1(ξ; η); N_2(ξ; η); N_3(ξ; η); N_4(ξ; η)]

"Derivadas de las funciones de interpolación:
#sym dN(ξ; η) = [pdiff(N_1(ξ; η); ξ); pdiff(N_2(ξ; η); ξ); pdiff(N_3(ξ; η); ξ); pdiff(N_4(ξ; η); ξ)|pdiff(N_1(ξ; η); η); pdiff(N_2(ξ; η); η); pdiff(N_3(ξ; η); η); pdiff(N_4(ξ; η); η)]

"Coordenadas del elemento:
X = [0; 1; 1; 0]
Y = [-1; -1; 0; 0]
XY = augment(X; Y)

"Jacobiano:
J(ξ; η) = dN(ξ; η)*XY

"Derivadas de las funciones de interpolación con respecto al sistema original:
d'N(ξ; η) = (J(ξ; η)^(-1))*dN(ξ; η)

"Construcción de la matriz de deformación para flexión:
f(i; j) = 0
''B_b:
t = matrix(3; 12; f)
#for i = 1 : 4
    t.1; 3*i - 1 = (d'N(ξ; η)).1; i
    t.2; 3*i = (d'N(ξ; η)).2; i
    t.3; 3*i - 1 = (d'N(ξ; η)).2; i
    t.3; 3*i = (d'N(ξ; η)).1; i
#loop

"Construcción de la matriz de deformación por corte:
''B_s:
t = matrix(2; 12; f)
#for i = 1 : 4
    t.1; 3*i - 2 = (d'N(ξ; η)).1; i
    t.1; 3*i - 1 = -(N(ξ; η)).1; i
    t.2; 3*i - 2 = (d'N(ξ; η)).2; i
    t.2; 3*i = -(N(ξ; η)).1; i
#loop

"Puntos de integración:
ξ' = [-1/?^(1/3); -(1/?^(1/3)); 1/?^(1/3); 1/?^(1/3)]
η' = [-1/?^(1/3); 1/?^(1/3); -(1/?^(1/3)); 1/?^(1/3)]
W = [1; 1; 1; 1]

"Matrices aumentadas para integración reducida:
D_f = stack(augment(D_f; matrix(3; 2; f)); matrix(2; 5; f))
D_s = stack(matrix(3; 5; f); augment(matrix(2; 3; f); D_s))
B_b(ξ; η) = stack(B_b(ξ; η); matrix(2; 12; f))
B_s(ξ; η) = stack(matrix(3; 12; f); B_s(ξ; η))

"Matriz de rigidez:
j = 1 : 4
Φ.j = transp((B_b(ξ'.j; η'.j)))*D_f*(B_b(ξ'.j; η'.j))*det(J(ξ'.j; η'.j))*W.j
K_b = sum(Φ.j; 1; 4)
K_s = 2*2*transp((B_s(0; 0)))*D_s*(B_s(0; 0))*det(J(0; 0))
K_T = K_b + K_s
K_b
K_s
K_T
