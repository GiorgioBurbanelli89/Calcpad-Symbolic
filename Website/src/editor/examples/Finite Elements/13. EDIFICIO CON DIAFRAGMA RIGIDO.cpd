'PASO 1) DEFINIR UNIDADES BASE
Fuerza = 1tonf
Longitud = 1m
χ = 1/Longitud
φ = χ^2
Υ = χ/(φ*Fuerza)
ψ = Fuerza*s^2/Longitud
'PASO 2) DEFINIR GEOMETRIA DEL EDIFICIO
N_pisos = 3
i = 1 : N_pisos
f(i; j) = 0
NGL_glob = N_pisos*3
'Numero y Coordenadas depórticos:
Vertice_1 = [1; 2; 3; 4; 5; 6]
X_1 = [0; 6; 12; 0; 6; 12]m
Y_1 = [0; 0; 0; 7; 7; 7]m
Portico = [1; 2; 3; 4; 5]
inicio_1 = [1; 4; 1; 2; 3]
fin_1 = [3; 6; 4; 5; 6]
N_porticos1 = len(inicio_1)
i' = 1 : N_porticos1
