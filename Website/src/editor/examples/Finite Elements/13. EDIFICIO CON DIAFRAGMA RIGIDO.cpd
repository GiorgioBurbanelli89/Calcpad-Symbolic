'Análisis Pseudo tridimensional
'Calculo de las matrices de compatibilidad de los pórticos con respecto al centro de masa:
''SC:
SC = matrix(N_porticos1; 3; f)
#for j = 1 : N_porticos1
    x_i.j = X_1.inicio_1.j
    x_f.j = X_1.fin_1.j
    y_i.j = Y_1.inicio_1.j
    y_f.j = Y_1.fin_1.j
    d = ?^(1/(x_f.j - x_i.j)^2 + (y_f.j - y_i.j)^2)
    SC.j; 1 = y_f.j - y_i.j/d
    SC.j; 2 = x_f.j - x_i.j/d
    SC.j; 3 = identity(N_pisos)
    #for k = 1 : N_pisos
        (SC.j; 3).k; k = ((0m - y_i.j)*SC.j; 2 - (0m - x_i.j)*SC.j; 1)/Longitud
    #loop
#loop
''SC':
SC' = matrix(N_porticos1; 3; f)
#for j = 1 : N_porticos1
    x_i.j = X_1.inicio_1.j
    x_f.j = X_1.fin_1.j
    y_i.j = Y_1.inicio_1.j
    y_f.j = Y_1.fin_1.j
    d = ?^(1/(x_f.j - x_i.j)^2 + (y_f.j - y_i.j)^2)
    SC'.j; 1 = y_f.j - y_i.j/d
    SC'.j; 2 = x_f.j - x_i.j/d
    SC'.j; 3 = identity(N_pisos)
    #for k = 1 : N_pisos
        (SC'.j; 3).k; k = ((Y_cg.k - y_i.j)*SC.j; 2 - (X_cg.k - x_i.j)*SC.j; 1)/Longitud
    #loop
#loop
COS.i' = identity(N_pisos)*SC.i'; 2
SEN.i' = identity(N_pisos)*SC.i'; 1
COS'.i' = identity(N_pisos)*SC'.i'; 2
SEN'.i' = identity(N_pisos)*SC'.i'; 1
R_por.i' = SC.i'; 3
a_port.i' = augment(COS.i'; SEN.i'; R_por.i')
R'_por.i' = SC'.i'; 3
a'_port.i' = augment(COS'.i'; SEN'.i'; R'_por.i')
a'_port.1
'Matriz de rigidez de la estructura:
a'_glob.i' = submatrix(a'_port.i'; 1; n_cols(K_p.i'); 1; NGL_glob)
a'_glob.5
