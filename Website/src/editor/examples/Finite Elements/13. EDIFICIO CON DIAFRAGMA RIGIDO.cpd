'Coordenadas del centro de gravedad:
L_x = [12; 12; 6]m
L_y = [7; 7; 7]m
X_cg = L_x/2
Y_cg = L_y/2
'Rigidez lateral de cada pórtico:
K_p.1 = [4770.33695; -2974.92336; 228.58972|-2974.92336; 4439.71332; -1777.30898|228.58972; -1777.30898; 1561.28199]
K_p.2 = K_p.1
